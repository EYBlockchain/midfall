A = 0x1115160ded643518fc0b46ad430da8e5c15f85fe03d0b6b181060f8c167714c650b31b4850b2f06430903acabcee293a8f88eb2a94554636fe823e6b6e753f7de3b6436b32518715df94030bf910993d5158cf47c83042e3fff16181819155f4
G = (0x858cd5e8856db40d611f0c8a605296b64146118a5112bd5f25333eecbcb0b22ba689491990304ac0c709e99af8cc0c789131f940ec79936f4c75a24ef7165eb1e53f0ffb46a931d2ec95ba678b5825cb3649ab4d4e4b206dcbc62236fefa3bc1, 0x461e32608d4000477828abe7e900882d9864d3792b38a332b6fab213a9bf840fe3cb7b3be185266143c493e8d10d9cf37ea8f90695b7e6bdc17938cb7d11dd4e40f7f4037e9e0e3307e4e1de207f56a51e62eab3bb21ca6ebbc3f9bc8e4be604)
alice = (0x8a7fe719d98da61cba2b5abdd2c7461b792222f823cd14858692b19b946800a1c510d831247d49c26b52cedf4726263307b2487726210382e37ce882c93141cba24881ce2b5e4815f18370b5c6443116aa1f4f02001c09cf3947f2decd07c6, 0x5e4c3391c7c8d3ab7ce8328cbd456c8d852a87f86a683ee102c7d6fe52fdf10a8d9cf48e14fdb4e2b40ba4078e154e3a50e3d3d9ab886968dea5dc1b73b0c995d27fcc20181f671aff4cd2d68fceda73da3c99e48df70ace5d6051b4fb4d9abd)
bob = (0x7f6723b21ab7350fb244f260e197dec47d241818216d77e6f1d8fabf11aa7d1b37d382629668d63823ef6b46351eac3ba0b8eed3676b7b0ea6355df9841ecd37d053d4124eb869effd2d8f5960917f34fbc1adee5130669a458b1bc612f22dcf, 0x63c0c62f2c1f799f87e0e77fcef4445c68374b488672bb2d20049f866594db691f4163477c6c2471cb8c053a2209966ab91522aae1f2c5c86e3cd74d77ac12957393ac59c969a7fb14626a0c1b1d37de3ed1db86105f3c58af742c9b67fa641e)
gx,gy = G; ax,ay = alice; bx,by = bob

# differences that are 0 mod n
d1 = gy^2 - ay^2 - gx^3 + ax^3 - A*gx + A*ax
d2 = ay^2 - by^2 - ax^3 + bx^3 - A*ax + A*bx
d3 = gy^2 - by^2 - gx^3 + bx^3 - A*gx + A*bx
print("d1 bits", d1.nbits(), "d2 bits", d2.nbits())
g = gcd(gcd(d1,d2), d3)
print("gcd =", g)
print("gcd bits", g.nbits())
print("gcd factors small:", factor(g, limit=10^6, proof=False))
n = g
print("n odd?", n%2)
n2 = n//2 if n%2==0 else n
# try removing all 2s
m=n
while m%2==0: m//=2
print("n after removing 2s =", m)
print("bits", m.nbits())
