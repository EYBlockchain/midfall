import Midfall.Instances.PoseidonValid
set_option autoImplicit false
open Midfall Midfall.Generator Midfall.Lowering Midfall.LoweringV2 Midfall.Instances.PoseidonValid
open YulSemantics YulSemantics.EVM

/-! GenLits: print the deployment slices as `yul%` literals plus native_decide pins (generated). -/

def emitLit (name : String) (b : Block EVM.Op) : String :=
  s!"def {name} : Block EVM.Op :=\n  {(repr b).pretty 100}\n\n"

def emitPin (name : String) (lhs : String) : String :=
  s!"theorem {name}_eq : {lhs} = {name} :=\n  YulSemantics.SyntaxEq.stmtsBeq_eq _ _ (by native_decide)\n\n"

def header : String :=
  "import Midfall.Instances.PoseidonValid\nset_option autoImplicit false\n" ++
  "/-! GENERATED by GenLits.lean (scratch). The deployment's closed slices as literals. -/\n" ++
  "namespace Midfall.Scratch.ProofTech.Lits\n" ++
  "open Midfall Midfall.Lowering Midfall.LoweringV2 Midfall.Instances.PoseidonValid\n" ++
  "open YulSemantics YulSemantics.EVM\n\n"

def body : String :=
  header ++
  emitLit "helpersLit" (helpersOf poseidonPv poseidonM) ++
  emitLit "traceReturnLit" (sliceOf poseidonPv poseidonM .traceReturn) ++
  emitLit "vkLoadingLit" (sliceOf poseidonPv poseidonM .vkLoading) ++
  emitLit "lagrangeLit" (sliceOf poseidonPv poseidonM .lagrange) ++
  emitLit "finalPairingLit" (sliceOf poseidonPv poseidonM .finalPairing) ++
  emitPin "helpersLit" "helpersOf poseidonPv poseidonM" ++
  emitPin "traceReturnLit" "sliceOf poseidonPv poseidonM Partial.traceReturn" ++
  emitPin "vkLoadingLit" "sliceOf poseidonPv poseidonM Partial.vkLoading" ++
  emitPin "lagrangeLit" "sliceOf poseidonPv poseidonM Partial.lagrange" ++
  emitPin "finalPairingLit" "sliceOf poseidonPv poseidonM Partial.finalPairing" ++
  "#print axioms helpersLit_eq\n" ++
  "end Midfall.Scratch.ProofTech.Lits\n"

#eval IO.FS.writeFile
  "Lits.generated.lean" body
