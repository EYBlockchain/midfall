-- |
-- Midfall.Generator.YulGolden
--
-- The M3 golden test under D-P13: equality between what the generator will produce
-- and what the Rust produced is STRUCTURAL on the vendored Yul AST, not textual.
-- Formatting and comments are outside the relation, so the check is: the token
-- stream of the printed AST equals the token stream of the committed bytes, where
-- the token stream drops whitespace, drops '//'-comments, and normalises every
-- numeric literal to its value (so '0x20', '0x0020' and '32' are one token).
--
-- SOURCE OF THE FIXTURES - READ THIS BEFORE TRUSTING A GREEN.
-- The slices are transcribed from proofs/solidity-verifier/target/poseidon-fixture-dump/*.sol, which is tracked and was
-- regenerated by the CURRENT generator (commit 5312cb7, 2026-10-23: it carries
-- 'pragma solidity 0.8.30', the typed-error taxonomy 'fail(ERR_...)', and the
-- on-chain BUILD_ID). They are NOT taken from
-- deployments/sepolia/moonlight-wrap/, which is the deployed artifact but was
-- generated on 2026-05-19 (4bab29c) by five months of superseded templates: it has
-- no typed errors, pins '^0.8.24', and contains a 'q_acc' quotient-direct emitter
-- that no longer exists anywhere in src. Anchoring the golden test on stale bytes
-- would certify the wrong generator. docs/ecosystem.md section 12 carries the
-- construct-by-construct measurement.
--
-- WHY THIS IS NOT VACUOUS. The expected side is a token stream computed from the
-- committed bytes; the printed side comes from YulSemantics.PrettyPrint applied to
-- an AST built by the yul% DSL. Neither was written to match the other, and
-- docs/REVIEW.md R-20/R-30/R-34 is exactly the failure mode of a check whose two
-- sides share a definition. The discrimination gates at the bottom show the
-- relation can fail: renaming one identifier, swapping two arguments, changing one
-- literal value, or changing one statement turns a gate red. stmtBeq compares
-- identifier STRINGS, so alpha-renaming is NOT quotiented - if the Lean port emits
-- a different variable name from the Rust, these gates fail loudly.
--
-- WHY THE DSL AND NOT A RUNTIME PARSER. YulSemantics.Syntax is an elaborator:
-- 'yul% { ... }' turns source into an AST at elaboration time. The vendored tree
-- ships no runtime Yul parser, so the fixtures are transcribed from the artifact
-- and the token comparison is what checks the transcription.

import YulSemantics.Syntax
import YulSemantics.PrettyPrint

namespace Midfall.Generator

/-- One line with its '//' comment removed. The committed assembly contains no
    string literal, so a naive cut is exact here; a Yul with a '//'-inside-a
    literal would need the lexer rather than this. -/
def stripLineComment (l : String) : String :=
  match l.splitOn "//" with
  | [] => l
  | first :: _ => first

/-- Drop every '//'-comment, line by line. -/
def stripYulComments (s : String) : String :=
  String.intercalate "\n" (List.map stripLineComment (s.splitOn "\n"))

/-- Whitespace around every token boundary so a split can separate them. ':' and
    '=' are padded independently, so ':=' becomes two tokens on BOTH sides of
    every comparison - the normalisation never has to recognise it. -/
def padYulPunct (s : String) : String :=
  List.foldl (fun (acc : String) (p : String × String) => acc.replace p.fst p.snd) s
    [ ("(", " ( "), (")", " ) "), ("{", " { "), ("}", " } "), (",", " , "),
      ("-", " - "), (">", " > "), ("=", " = "), (":", " : ") ]

/-- Newlines and tabs become spaces: 'EVM.print' separates statements with LF and
    the committed file indents with spaces, so whitespace of any kind is a token
    boundary and nothing more. -/
def flattenWs (s : String) : String :=
  String.replace (String.replace s "\n" " ") "\t" " "

/-- Split on whitespace, dropping the empty runs that padded punctuation leaves. -/
def splitWs (s : String) : List String :=
  List.filter (fun t => !t.isEmpty) ((flattenWs s).splitOn " ")

/-- Value of a hex literal body. -/
def hexVal (t : String) : Nat :=
  t.foldl (fun (acc : Nat) (c : Char) =>
    acc * 16 + if c >= '0' && c <= '9' then c.toNat - '0'.toNat
      else if c >= 'a' && c <= 'f' then c.toNat - 'a'.toNat + 10
      else c.toNat - 'A'.toNat + 10) 0

/-- One token, with numeric literals reduced to their decimal value. -/
def normYulToken (t : String) : String :=
  if t.startsWith "0x" || t.startsWith "0X" then toString (hexVal ((t.drop 2).toString)) else t

/-- The token stream of a Yul program: comments and whitespace gone, literals
    reduced to values. This IS the D-P13 equality. -/
def yulTokens (s : String) : List String :=
  List.map normYulToken (splitWs (padYulPunct (stripYulComments s)))

/-- The token stream, space-joined, so an expectation is one compact string. -/
def yulTokenStream (s : String) : String := String.intercalate " " (yulTokens s)

end Midfall.Generator

namespace Midfall.Generator.Golden
open Midfall.Generator YulSemantics


