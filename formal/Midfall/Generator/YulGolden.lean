/-! ## The golden gates: printed AST equals committed bytes, modulo D-P13 -/

def smoke_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print smoke_ast) == yulTokens smoke_committed

def scalarInv_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print scalarInv_ast) == yulTokens scalarInv_committed

def batchInv_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print batchInv_ast) == yulTokens batchInv_committed

def lagrangeFor_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print lagrangeFor_ast) == yulTokens lagrangeFor_committed

def vmSwitch_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print vmSwitch_ast) == yulTokens vmSwitch_committed

def pcsBasis_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print pcsBasis_ast) == yulTokens pcsBasis_committed

def spread_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print spread_ast) == yulTokens spread_committed

def vkHead_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print vkHead_ast) == yulTokens vkHead_committed

/-- All eight slices at once. Each side goes through yulTokens: the pinned string
    is the artifact token stream as the extraction script wrote it (with the pair
    ':=' kept whole), and the printed side is the vendored printer's output.
    Re-tokenising the pinned string makes the comparison about the program rather
    than about the script choice of how to spell one token. -/
def golden_all_ok : Bool :=
  smoke_golden_ok &&
  scalarInv_golden_ok &&
  batchInv_golden_ok &&
  lagrangeFor_golden_ok &&
  vmSwitch_golden_ok &&
  pcsBasis_golden_ok &&
  spread_golden_ok &&
  vkHead_golden_ok

/-! ## Discrimination: the relation can fail

Without these the gates above are unfalsifiable, which is the R-20/R-34 failure
shape. Each conjunct is evaluated on its own so a vacuous one cannot hide. -/

/-- Identifier names are compared as STRINGS: renaming one variable breaks the
    check, so a port that emits different names cannot pass silently. -/
def discriminates_ident_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { let scratch := 0x80 }) (yul% { let other := 0x80 })
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { let scratch := 0x80 }) (yul% { let scratch := 0x80 })

/-- Argument order is significant. -/
def discriminates_argOrder_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { sub(r, 1) }) (yul% { sub(1, r) })
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { sub(r, 1) }) (yul% { sub(r, 1) })

/-- Literal VALUES are significant; their spelling is not. That is exactly what
    D-P13 relaxes, pinned rather than assumed. -/
def discriminates_literal_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { let x := 33 }) (yul% { let x := 32 })
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { let x := 32 }) (yul% { let x := 0x20 })
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { let x := 32 }) (yul% { let x := 0x0020 })

/-- Statement count and statement kind are significant. -/
def discriminates_shape_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { if c { s(0) } }) (yul% { if c { s(0) t(1) } })
    && ! YulSemantics.SyntaxEq.stmtsBeq (yul% { leave }) (yul% { break })

/-- Perturbing one identifier of a real fixture turns its gate red: the golden
    comparisons are not self-consistent tautologies. -/
def discriminates_fixture_ok : Bool :=
