/-! ## Secondary golden gates: printed AST equals the pinned token stream

These compare 'EVM.print' of the DSL AST against the pinned string. They are the
gates scripts/check_golden_provenance.py ties back to the bytes, so they are what
checks the transcription. They are NOT the D-P13 equality: see the header and
'discriminates_builtinVsCall_ok'. -/

def smoke_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print smoke_ast) == yulTokens smoke_committed

def scalarInv_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print scalarInv_ast) == yulTokens scalarInv_committed

def batchInv_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print batchInv_ast) == yulTokens batchInv_committed

def lagrangeFor_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print lagrangeFor_ast) == yulTokens lagrangeFor_committed

def vmSwitch_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print vmSwitch_ast) == yulTokens vmSwitch_committed

def pcsBasis_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print pcsBasis_ast) == yulTokens pcsBasis_committed

def spread_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print spread_ast) == yulTokens spread_committed

def vkHead_golden_ok : Bool :=
  yulTokens (YulSemantics.EVM.print vkHead_ast) == yulTokens vkHead_committed

/-- All eight slices at once. Each side goes through yulTokens: the pinned string
    is the artifact token stream as the extraction script wrote it (with the pair
    ':=' kept whole), and the printed side is the vendored printer's output.
    Re-tokenising the pinned string makes the comparison about the program rather
    than about the script choice of how to spell one token. -/
def golden_all_ok : Bool :=
  smoke_golden_ok &&
  scalarInv_golden_ok &&
  batchInv_golden_ok &&
  lagrangeFor_golden_ok &&
  vmSwitch_golden_ok &&
  pcsBasis_golden_ok &&
  spread_golden_ok &&
  vkHead_golden_ok

/-! ## Authoritative golden gates: stmtsBeq, AST against AST

One gate per fixture, comparing the AST the 'yul%' DSL elaborated from the
transcribed source against the same slice written with raw constructors. This is
the relation Phase 5's irCheck will use, so it is the one D-P13 names.

What these gates rule out, concretely: the DSL elaborator mapping a built-in name
to 'Expr.call' (or a user name to 'Expr.builtin') - invisible to every token gate
above; 'for' init/post/body being elaborated in a different order; a 'case' label
elaborating as an expression rather than a 'Literal'; and a hex literal
elaborating to a different value than the pinned decimal. Each of those is a
change in vendored code this repository does not control, and each would keep
every token gate green. Multi-name 'let' is NOT covered here - no fixture slice
contains one - so 'discriminates_multiNameLet_ok' below pins it separately.

What they do NOT rule out: a transcription error copied into both sides. That is
what scripts/check_golden_provenance.py is for. -/

def smoke_beq_ok : Bool := YulSemantics.SyntaxEq.stmtsBeq smoke_ast smoke_direct
def scalarInv_beq_ok : Bool := YulSemantics.SyntaxEq.stmtsBeq scalarInv_ast scalarInv_direct
def batchInv_beq_ok : Bool := YulSemantics.SyntaxEq.stmtsBeq batchInv_ast batchInv_direct
def lagrangeFor_beq_ok : Bool := YulSemantics.SyntaxEq.stmtsBeq lagrangeFor_ast lagrangeFor_direct
def vmSwitch_beq_ok : Bool := YulSemantics.SyntaxEq.stmtsBeq vmSwitch_ast vmSwitch_direct
def pcsBasis_beq_ok : Bool := YulSemantics.SyntaxEq.stmtsBeq pcsBasis_ast pcsBasis_direct
def spread_beq_ok : Bool := YulSemantics.SyntaxEq.stmtsBeq spread_ast spread_direct
def vkHead_beq_ok : Bool := YulSemantics.SyntaxEq.stmtsBeq vkHead_ast vkHead_direct

/-- All eight under the authoritative relation. -/
def golden_beq_all_ok : Bool :=
  smoke_beq_ok && scalarInv_beq_ok && batchInv_beq_ok && lagrangeFor_beq_ok &&
  vmSwitch_beq_ok && pcsBasis_beq_ok && spread_beq_ok && vkHead_beq_ok

/-! ## Discrimination: the relations can fail

Without these the gates above are unfalsifiable, which is the R-20/R-34 failure
shape. Each conjunct is evaluated on its own so a vacuous one cannot hide. -/

/-- Identifier names are compared as STRINGS: renaming one variable breaks the
    check, so a port that emits different names cannot pass silently. -/
def discriminates_ident_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { let scratch := 0x80 }) (yul% { let other := 0x80 })
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { let scratch := 0x80 }) (yul% { let scratch := 0x80 })

/-- Argument order is significant. -/
def discriminates_argOrder_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { sub(r, 1) }) (yul% { sub(1, r) })
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { sub(r, 1) }) (yul% { sub(r, 1) })

/-- Literal VALUES are significant; their spelling is not. That is exactly what
    D-P13 relaxes, pinned rather than assumed. -/
def discriminates_literal_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { let x := 33 }) (yul% { let x := 32 })
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { let x := 32 }) (yul% { let x := 0x20 })
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { let x := 32 }) (yul% { let x := 0x0020 })

/-- The DSL elaborates a multi-name 'let' as ONE 'letDecl' carrying a list of
    names, and likewise for a multi-name assignment. No fixture slice contains
    either (the corpus sites are D:1074 and D:1019, outside the eight slices), so
    nothing else in this file would notice the vendored elaborator splitting a
    multi-name declaration into several single-name ones, or dropping a name. -/
def discriminates_multiNameLet_ok : Bool :=
  YulSemantics.SyntaxEq.stmtsBeq (yul% { let a, b := f() })
      [Stmt.letDecl ["a", "b"] (some (usrFn "f" []))]
    && ! YulSemantics.SyntaxEq.stmtsBeq (yul% { let a, b := f() })
      [Stmt.letDecl ["a"] (some (usrFn "f" []))]
    && YulSemantics.SyntaxEq.stmtsBeq (yul% { a, b := f() })
      [Stmt.assign ["a", "b"] (usrFn "f" [])]

/-- Statement count and statement kind are significant. -/
def discriminates_shape_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { if c { s(0) } }) (yul% { if c { s(0) t(1) } })
    && ! YulSemantics.SyntaxEq.stmtsBeq (yul% { leave }) (yul% { break })

/-- THE RELATION GAP, pinned. 'add(1, 2)' as the built-in and 'add(1, 2)' as a
    call to a user function named 'add' print identically, so the token relation
    says they are the same program; stmtsBeq says they are not. The wrong
    implementation this rules out is a port that emits '.call "add"' (or '.call
    "mstore"') where the Rust means the dialect built-in: it passes every token
    gate in this file and is rejected by Phase 5's irCheck. If PrettyPrint ever
    distinguished the two, the second conjunct goes red and this file's claim that
    the token relation is weaker has to be re-examined - which is the point. -/
def discriminates_builtinVsCall_ok : Bool :=
  ! YulSemantics.SyntaxEq.stmtsBeq (yul% { add(1, 2) })
      [stmtE (usrFn "add" [litN 1, litN 2])]
    && yulTokens (YulSemantics.EVM.print (yul% { add(1, 2) }))
       == yulTokens (YulSemantics.EVM.print [stmtE (usrFn "add" [litN 1, litN 2])])

/-- Perturbing a REAL fixture by exactly one token turns BOTH relations red.
    lagrangeFor_perturbed is the fixture with the '1' of 'add(idx, 1)' changed to
    a '2': same statement count, same identifiers, same shapes, same nesting - the
    only difference in the whole tree is one literal value. Write 'litN 1' here
    and this gate goes false; that is the experiment that falsifies it. The
    previous version compared a one-statement block against a twenty-four-statement
    fixture and so was true with no perturbation at all (R-38 finding 4). -/
def lagrangeFor_perturbed : Block EVM.Op :=
  [ Stmt.forLoop [Stmt.letDecl ["idx"] (some (litN 0))]
      (binOp EVM.Op.lt [varX "idx", varX "k"])
      [Stmt.assign ["idx"] (binOp EVM.Op.add [varX "idx", litN 2])]
      [Stmt.assign ["x_n"] (binOp EVM.Op.mulmod [varX "x_n", varX "x_n", varX "r"])]
  ]

def discriminates_fixture_ok : Bool :=
  yulTokens (YulSemantics.EVM.print lagrangeFor_ast)
    != yulTokens (YulSemantics.EVM.print lagrangeFor_perturbed)
    && ! YulSemantics.SyntaxEq.stmtsBeq lagrangeFor_ast lagrangeFor_perturbed

/-- The same minimal-perturbation shape for an identifier: 'x_n' becomes 'x_m'
    everywhere it occurs and nothing else changes. Rules out a port that emits a
    different variable name for the Lagrange accumulator while keeping the
    statement count and the shapes identical. -/
def lagrangeFor_renamed : Block EVM.Op :=
  [ Stmt.forLoop [Stmt.letDecl ["idx"] (some (litN 0))]
      (binOp EVM.Op.lt [varX "idx", varX "k"])
      [Stmt.assign ["idx"] (binOp EVM.Op.add [varX "idx", litN 1])]
      [Stmt.assign ["x_m"] (binOp EVM.Op.mulmod [varX "x_m", varX "x_m", varX "r"])]
  ]

def discriminates_fixtureIdent_ok : Bool :=
  yulTokens (YulSemantics.EVM.print lagrangeFor_ast)
    != yulTokens (YulSemantics.EVM.print lagrangeFor_renamed)
    && ! YulSemantics.SyntaxEq.stmtsBeq lagrangeFor_ast lagrangeFor_renamed

/-- Fuel exhaustion is loud, and the token relation can see it. The renderer in
    Midfall/Generator/Render.lean is fuel-bounded; the golden gates above print
    with the VENDORED printer and never call it, so a too-small budget would not
    redden them (R-38 finding 5). What this gate establishes is the weaker, honest
    claim: if a golden comparison is ever routed through 'renderStmt' - which is
    what the real generator will do - then running out of fuel changes the token
    stream, so the change is caught rather than silently truncating output. The
    second conjunct is the cross-check that makes the first meaningful: with
    enough fuel this renderer and the vendored printer agree on the same tokens
    for the same AST, so the only thing the first conjunct can be seeing is the
    marker. -/
def fuelProbeBlock : Block EVM.Op := yul% { if c { if d { revert(0, 0) } } }

def golden_detectsFuelExhaustion_ok : Bool :=
  yulTokens (Midfall.Generator.multilineBody (Midfall.Generator.renderStmtFuel 2) 0 fuelProbeBlock)
    != yulTokens (Midfall.Generator.multilineBody (Midfall.Generator.renderStmtFuel 3) 0 fuelProbeBlock)
    && yulTokens (Midfall.Generator.multilineBody (Midfall.Generator.renderStmtFuel 3) 0 fuelProbeBlock)
       == yulTokens (YulSemantics.EVM.print fuelProbeBlock)

end Midfall.Generator.Golden

