-- |
-- Midfall.Generator.YulGolden
--
-- The M3 golden test under D-P13: equality between what the generator will produce
-- and what the Rust produced is STRUCTURAL on the vendored Yul AST, not textual.
--
-- WHICH RELATION IS AUTHORITATIVE - READ THIS FIRST.
-- The authoritative relation is 'YulSemantics.SyntaxEq.stmtsBeq'
-- (vendor/yul-semantics/YulSemantics/Ast.lean:147), the executable structural
-- equality on the vendored AST. That is what Phase 5's irCheck will use, so it is
-- what the '<base>_beq_ok' gates below establish. The token-stream relation
-- defined under this header is a SECONDARY check and it is STRICTLY WEAKER:
-- 'YulSemantics.PrettyPrint' prints 'Expr.builtin' and 'Expr.call' with the same
-- shape (PrettyPrint.lean:44-45) while 'Ast.lean:109-113' keeps the two
-- constructors apart, so 'add(1, 2)' as a built-in and 'add(1, 2)' as a call to a
-- user function named 'add' have equal token streams and unequal stmtsBeq. A port
-- that emits '.call' where the Rust means the built-in passes every token gate and
-- fails irCheck. 'discriminates_builtinVsCall_ok' pins exactly that asymmetry, and
-- docs/ecosystem.md 12.3 states it. Do not describe the token relation as the
-- D-P13 equality: it is a conservative approximation of it that ignores formatting
-- and comments and, unlike stmtsBeq, also ignores the built-in/user-call split.
--
-- SOURCE OF THE FIXTURES - READ THIS BEFORE TRUSTING A GREEN.
-- The slices are transcribed from
-- proofs/solidity-verifier/target/poseidon-fixture-dump/*.sol, which is tracked and
-- was regenerated by the CURRENT generator (commit 5312cb7, 2026-10-23: it carries
-- 'pragma solidity 0.8.30', the typed-error taxonomy 'fail(ERR_...)', and the
-- on-chain BUILD_ID). They are NOT taken from
-- deployments/sepolia/moonlight-wrap/, which is the deployed artifact but was
-- generated on 2026-05-19 (4bab29c) by five months of superseded templates: it has
-- no typed errors, it pins '^0.8.24', and it contains a 'q_acc' quotient-direct
-- emitter that no longer exists anywhere in src. Anchoring the golden test on stale
-- bytes would certify the wrong generator. docs/ecosystem.md section 12 carries the
-- construct-by-construct measurement.
--
-- WHAT ACTUALLY TIES THESE PINS TO THE FILE: NOTHING IN THIS MODULE. No Lean term
-- opens the .sol; every expectation below is a pasted string literal. The drift
-- protection is scripts/check_golden_provenance.py, which re-reads each cited line
-- range, re-tokenises it with the rules documented below, and asserts the pinned
-- string, the line/byte/token counts and the sha256. It runs from scripts/checks.sh.
-- If that script is deleted or stops being run, every gate in this file degrades
-- into a check that an AST matches a string somebody typed - the R-38 failure.
--
-- RE-DERIVING A HASH. The recipe the original commit gave -
-- 'sed -n A,Bp FILE | shasum -a 256' - reproduces NONE of the eight hashes,
-- because sed appends a newline after the last selected line and the pinned slice
-- has none. The hash is of lines A..B joined by LF with NO trailing LF, as UTF-8.
-- Run 'python3 scripts/check_golden_provenance.py' to re-derive all eight at once.
--
-- WHY THIS IS NOT VACUOUS. The expected side is a token stream that
-- scripts/check_golden_provenance.py re-derives from the committed bytes; the
-- printed side comes from YulSemantics.PrettyPrint applied to an AST built by the
-- yul% DSL; the third side ('<base>_direct') is the same AST written with raw
-- constructors, compared with stmtsBeq. No two of the three share a definition.
-- The discrimination gates at the bottom show the relations can fail: renaming one
-- identifier of a real fixture, changing one literal value of a real fixture, or
-- turning a built-in into a user call turns a gate red. stmtBeq compares
-- identifier STRINGS, so alpha-renaming is NOT quotiented - if the Lean port emits
-- a different variable name from the Rust, these gates fail loudly.
--
-- WHY THE DSL AND NOT A RUNTIME PARSER. YulSemantics.Syntax is an elaborator:
-- 'yul% { ... }' turns source into an AST at elaboration time. The vendored tree
-- ships no runtime Yul parser, so the fixtures are transcribed from the artifact
-- and the provenance script is what checks the transcription.

import YulSemantics.Syntax
import YulSemantics.PrettyPrint
import Midfall.Generator.Render

namespace Midfall.Generator

/-- One line with its '//' comment removed. The committed assembly contains no
    string literal, so a naive cut is exact here; a Yul with a '//'-inside-a
    literal would need the lexer rather than this. scripts/check_golden_provenance.py
    refuses to check a slice that contains a quote for exactly this reason. -/
def stripLineComment (l : String) : String :=
  match l.splitOn "//" with
  | [] => l
  | first :: _ => first

/-- Drop every '//'-comment, line by line. -/
def stripYulComments (s : String) : String :=
  String.intercalate "\n" (List.map stripLineComment (s.splitOn "\n"))

/-- Whitespace around every token boundary so a split can separate them. ':' and
    '=' are padded independently, so ':=' becomes two tokens on BOTH sides of
    every comparison - the normalisation never has to recognise it. -/
def padYulPunct (s : String) : String :=
  List.foldl (fun (acc : String) (p : String × String) => acc.replace p.fst p.snd) s
    [ ("(", " ( "), (")", " ) "), ("{", " { "), ("}", " } "), (",", " , "),
      ("-", " - "), (">", " > "), ("=", " = "), (":", " : ") ]

/-- Newlines and tabs become spaces: 'EVM.print' separates statements with LF and
    the committed file indents with spaces, so whitespace of any kind is a token
    boundary and nothing more. -/
def flattenWs (s : String) : String :=
  String.replace (String.replace s "\n" " ") "\t" " "

/-- Split on whitespace, dropping the empty runs that padded punctuation leaves. -/
def splitWs (s : String) : List String :=
  List.filter (fun t => !t.isEmpty) ((flattenWs s).splitOn " ")

/-- Value of a hex literal body. -/
def hexVal (t : String) : Nat :=
  t.foldl (fun (acc : Nat) (c : Char) =>
    acc * 16 + if c >= '0' && c <= '9' then c.toNat - '0'.toNat
      else if c >= 'a' && c <= 'f' then c.toNat - 'a'.toNat + 10
      else c.toNat - 'A'.toNat + 10) 0

/-- One token, with numeric literals reduced to their decimal value. -/
def normYulToken (t : String) : String :=
  if t.startsWith "0x" || t.startsWith "0X" then toString (hexVal ((t.drop 2).toString)) else t

/-- The token stream of a Yul program: comments and whitespace gone, literals
    reduced to values. SECONDARY check only - see the header: this relation is
    strictly weaker than 'YulSemantics.SyntaxEq.stmtsBeq', which is the one D-P13
    names. It exists because it is cheap to state against a byte slice, which is
    what makes the transcription checkable by scripts/check_golden_provenance.py. -/
def yulTokens (s : String) : List String :=
  List.map normYulToken (splitWs (padYulPunct (stripYulComments s)))

/-- The token stream, space-joined, so an expectation is one compact string. -/
def yulTokenStream (s : String) : String := String.intercalate " " (yulTokens s)

end Midfall.Generator

namespace Midfall.Generator.Golden
open Midfall.Generator YulSemantics

/-- Raw-constructor shorthands, so a direct AST is about the same size as the
    quotation it is checked against. 'binOp' builds a dialect built-in, 'usrFn' a
    user-defined call: the distinction the token relation cannot see. -/
private def varX (s : String) : Expr EVM.Op := .var s
private def litN (n : Nat) : Expr EVM.Op := .lit (Literal.number n)
private def binOp (op : EVM.Op) (args : List (Expr EVM.Op)) : Expr EVM.Op := .builtin op args
private def usrFn (nm : String) (args : List (Expr EVM.Op)) : Expr EVM.Op := .call nm args
private def stmtE (e : Expr EVM.Op) : Stmt EVM.Op := .exprStmt e
private def rev0 : Stmt EVM.Op := stmtE (binOp EVM.Op.revert [litN 0, litN 0])

