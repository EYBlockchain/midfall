/-! ## §5. `Done`, the five fields of the definition of done -/

/-- **D-B5'S BUILD_ID INPUT, AS A TERM.** The value on the tracked artifact's line
    `bytes32 public constant BUILD_ID = 0xf352...`; `ArtifactB5Poseidon` proves that line is
    exactly the one line at which the port's render differs from the artifact. -/
def poseidonArtifactBuildId : Word256 :=
  0xf352d2670376fa01229e35428d69c1d623c4b3edf42f15a78622888a9b4285fd

/-- **DONE AT THE POSEIDON DEPLOYMENT.** Exactly the five conjuncts of the definition of done.
    `cd` is supplied by the caller; `poseidonFixtureCalldata` is the value DG.5 gives it. -/
structure Done (cd : Bytes) : Prop where
  /-- 1. THE HEADLINE, for every pairing product. -/
  headline : ∀ product : PairingProduct, LoweringEquivalenceV3 poseidonRender product
  /-- 2. THE RENDER IS THE GENERATOR'S OUTPUT FOR THIS KEY. -/
  valid : ValidV3 poseidonRender
  /-- 3. NON-VACUITY: the hypotheses hold together at keccak256 on `cd`, which the Lean verifier
         ACCEPTS, for some product satisfying the precompile assumption. -/
  gate : ∃ product : PairingProduct, GateAtV3 poseidonRender product cd
  /-- 4. TOTALITY: the program is never stuck, for every product. -/
  total : ∀ product : PairingProduct, TotalV3 poseidonRender product
  /-- 5. THE TEXT IS THE RUST ARTIFACT at the D-B5 variant: the BUILD_ID input supplied
         (`ArtifactEqV3`). The raw `ArtifactEq` at this dump is refuted only by the BUILD_ID
         line, machine-checked in `Instances/ArtifactB5Poseidon.lean`. -/
  artifact : Midfall.LoweringV2.ArtifactEqV3 poseidonRender.model poseidonVerifierDump
    poseidonArtifactBuildId

/-- **THE BRIDGE THE PLAN ASKS FOR.** A `Done` yields `GeneratorDone` at the fixture: the generic
    headline is `lowering_correct`, and `valid` + `gate` are `nonvacuous`. PROVED. -/
theorem Done.toGeneratorDone {cd : Bytes} (d : Done cd) :
    GeneratorDone poseidonRender cd :=
  ⟨fun R product hR => lowering_correct R product hR, ⟨d.valid, d.gate⟩⟩

/-- **WHAT DONE YIELDS**: the frozen non-vacuity statement, for some product, at this calldata. -/
theorem Done.hypothesesInhabitedV3 {cd : Bytes} (d : Done cd) :
    ∃ product : PairingProduct, HypothesesInhabitedV3 poseidonRender product := by
  obtain ⟨product, hg⟩ := d.gate
  exact ⟨product, hypothesesInhabitedV3_of_gateAtV3 poseidonRender product cd hg⟩

/-- **AND AN HONEST RUN EXISTS**, for some product and some entry state: the gate is not "the
    contract never returns". -/
theorem Done.returns {cd : Bytes} (d : Done cd) :
    ∃ (product : PairingProduct) (vkAddr : U256) (st₀ : EvmState) (obs : Obs),
      RunBody poseidonRender vkAddr 0 (callsOf product) (ExternalGas.ofFun fun _ => 0) st₀ obs ∧
        obs.view = returnView st₀ :=
  GeneratorDone.returns d.toGeneratorDone

/-! ## §6. DONE IS NOT DONE TODAY -/

/-- **DONE CANNOT BE CONSTRUCTED TODAY, for any calldata.** Field 2 (`valid`) is refuted in the
    tree: `f1_ValidV3_false` (`Instances/VacuityWitnesses.lean:50`) is `¬ ValidV3 poseidonRender`,
    sorry-free, from the artifact-payload obstruction of `generated`. This is W12's falsifier for
    the statement DG.4 lands; DG.9 deletes this theorem in the commit that proves `generator_done`. -/
theorem not_done_today (cd : Bytes) : ¬ Done cd :=
  fun d => f1_ValidV3_false d.valid

end Midfall.Instances.GeneratorDone

