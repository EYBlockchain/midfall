/-
  Midfall.Instances.GeneratorDone  (DG.4 - "State `Done` for the generator theorem, with its
  refutation")

  DONE is ONE proposition with no fixture in its headline, landed together with the theorem that
  says it does not hold today. This file supplies:

    §1  `GateAtV3`, the non-vacuity gate at a GIVEN calldata: `HypothesesInhabitedV3` with `cd`
        supplied by the caller, plus the decoder/snapshot conjunct T7's V2 `GateAt` carried and the
        full `G1CodecLawsV3` bundle. `hypothesesInhabitedV3_of_gateAtV3` proves the frozen
        `HypothesesInhabitedV3` follows, so the gate is a STRENGTHENING and not a substitute.
    §2  `GeneratorDone` and `GeneratorDone.returns`, ported from the V3 evidence file
        `docs/plans/V3-evidence/lean/statements/GeneratorTheorem.lean` §3 verbatim.
    §3  `ArtifactEq`, ported from `docs/plans/V3-evidence/lean/tooling/T7.lean:737`.
    §4  `poseidonFixtureCalldata`, the tracked `calldata.bin` as a pure `Bytes` term, pinned by its
        size, selector and keccak256.
    §5  `Done`, the five fields of the definition of done (headline for every product, the render
        valid, the gate at keccak256 on the calldata, totality, and artifact equality), with
        `Done.toGeneratorDone`, `Done.hypothesesInhabitedV3` and `Done.returns`.
    §6  `not_done_today : ¬ Done cd` for EVERY calldata, from `f1_ValidV3_false`
        (`Instances/VacuityWitnesses.lean:50`), and the axiom print at the foot.

  W12. FALSIFIER: `not_done_today` is the refutation of the statement this card lands. The witness
  (`generator_done : Done poseidonFixtureCalldata`) is ABSENT BY DESIGN until B3's real point half
  and the remaining fields land; DG.9 deletes `not_done_today` in that commit.

  NO WEAKENING. `Done`'s `headline` is the landed `LoweringEquivalenceV3` at the fixture, `valid` is
  the landed `ValidV3`, `gate` is the strengthened `GateAtV3` at `keccak256`, `total` is the landed
  `TotalV3`, and `artifact` is T7's equality. No hypothesis was added to `ValidV3` or to any root.
  `Done` takes `cd` as a parameter; no fixture occurs in its headline (the fixture enters only
  through the `cd` argument and the last two fields, as in T7).

  D-GATE17: field 5 is the D-B5 artifact variant `ArtifactEqV3`, i.e. `ArtifactEq` with the
  BUILD_ID input supplied (`poseidonArtifactBuildId`, the tracked artifact's own value). The raw
  `ArtifactEq poseidonRender.model poseidonVerifierDump` is FALSE and stays refuted in
  `Instances/ArtifactB5Poseidon.lean`: the only differing line is BUILD_ID, machine-checked. This
  is the signed variant, not a weakening hidden inside `ArtifactEq`.
-/
import Midfall.LoweringV3.GeneratorTheorem
import Midfall.Instances.VacuityWitnesses
import Midfall.Instances.PoseidonInputs
import Midfall.Tools.Done

set_option autoImplicit false

namespace Midfall.LoweringV3

open Midfall Midfall.Halo2 Midfall.Generator Midfall.Lowering Midfall.Assumptions
open YulSemantics YulSemantics.EVM Midfall.Yul Midfall.Yul.Bridge
open Midfall.LoweringV2

variable {p : ℕ} [Fact (Nat.Prime p)] {G₁ G₂ Gₜ : Type}
  [Group G₁] [Group G₂] [Group Gₜ]
  [PrimeOrderWith G₁ p] [PrimeOrderWith G₂ p] [PrimeOrderWith Gₜ p]
  [Module (ZMod p) (Additive G₁)] [Module (ZMod p) (Additive G₂)]
  [Module (ZMod p) (Additive Gₜ)] [P : AdmissiblePairing G₁ G₂ Gₜ]

/-! ## §1. The non-vacuity gate at a given calldata -/

/-- **THE GATE**, at a GIVEN calldata: every hypothesis of the V3 headline holds together at
    `keccak256`, the calldata decodes, the snapshot exists, the Lean verifier ACCEPTS it, and the
    codec satisfies the full `G1CodecLawsV3` bundle. This is `HypothesesInhabitedV3` with `cd`
    supplied by the caller (so the gate speaks about the fixture's calldata and not about some
    calldata), plus the decoder/snapshot conjunct of T7's V2 `GateAt` and the full codec bundle. -/
def GateAtV3 (R : Render p G₁ G₂ Gₜ) (product : PairingProduct) (cd : Bytes) : Prop :=
  ∃ (W : ExecEnv) (Lyt : EVM.Layout) (vkAddr : U256) (st₀ : EvmState),
    DeploymentV2 R W keccak256 vkAddr ∧ EntryFrameV3 R W Lyt keccak256 cd st₀ ∧
      Eip2537.Holds R.E.g1 ⟨R.encG2⟩ product ∧ G1CodecLawsV3 R.E.g1 ∧
      LeanAccepts R keccak256 cd ∧ SoundSide R keccak256 cd ∧ CompleteSide R keccak256 cd ∧
      (∃ ms instW inst Snap,
        decodeCalldata (p := p) R.plan.proofLayout R.cfg.numInstances R.E.g1 cd =
          some (ms, instW) ∧
        Midfall.Lowering.instOfWords? (p := p) instW = some inst ∧
        snapshotOf R.E keccak256 R.vk inst ms none = .ok Snap)

/-- **NOTHING IS LOST BY PINNING THE CALLDATA.** The gate implies the frozen
    `HypothesesInhabitedV3`: the full codec bundle gives the headline bundle by
    `G1CodecLawsV3.headline`, and the decode/snapshot conjunct is dropped because
    `HypothesesInhabitedV3` does not carry it. PROVED. -/
theorem hypothesesInhabitedV3_of_gateAtV3 (R : Render p G₁ G₂ Gₜ) (product : PairingProduct)
    (cd : Bytes) (h : GateAtV3 R product cd) : HypothesesInhabitedV3 R product := by
  obtain ⟨W, Lyt, vkAddr, st₀, hdep, hentry, hpc, hcodec, hacc, hss, hcs, _⟩ := h
  exact ⟨W, Lyt, vkAddr, cd, st₀, hdep, hentry, hpc, hcodec.headline, hacc, hss, hcs⟩

/-! ## §2. `GeneratorDone`, ported from the V3 evidence file §3 -/

/-- **DONE, THE PROOF PART** (D-P71; the first three fields of PLAN-V3 §6's `Done`, bundled).
    `Rt` is a TEST render and `cd` its test calldata: they occur only in `nonvacuous`. -/
structure GeneratorDone (Rt : Render p G₁ G₂ Gₜ) (cd : Bytes) : Prop where
  /-- The generator theorem: every render, every pairing answer. -/
  headline : ∀ (R : Render p G₁ G₂ Gₜ) (product : PairingProduct),
    ValidV3 R → LoweringEquivalenceV3 R product
  /-- The theorem is not vacuous: its hypothesis and the headline's hypotheses hold together at one
      real circuit, whose calldata the Lean verifier accepts. -/
  nonvacuous : ValidV3 Rt ∧ ∃ product : PairingProduct, GateAtV3 Rt product cd

/-- What `GeneratorDone` buys at the test render, PROVED: an honest run exists and returns the ABI
    word `true`. (`returns_of_inhabited` through the two fields.) -/
theorem GeneratorDone.returns {Rt : Render p G₁ G₂ Gₜ} {cd : Bytes}
    (h : GeneratorDone Rt cd) :
    ∃ (product : PairingProduct) (vkAddr : U256) (st₀ : EvmState) (obs : Obs),
      RunBody Rt vkAddr 0 (callsOf product) (ExternalGas.ofFun fun _ => 0) st₀ obs ∧
        obs.view = returnView st₀ := by
  obtain ⟨hR, product, hg⟩ := h.nonvacuous
  exact ⟨product, returns_of_inhabited Rt product (h.headline Rt product hR)
    (hypothesesInhabitedV3_of_gateAtV3 Rt product cd hg)⟩

end Midfall.LoweringV3

/-! ## §3. `ArtifactEq`, ported verbatim from T7.lean:737 -/

namespace Midfall.LoweringV2

open Midfall Midfall.Halo2 Midfall.Generator Midfall.Lowering Midfall.Assumptions
open YulSemantics YulSemantics.EVM Midfall.Yul Midfall.Yul.Bridge

/-- **ARTIFACT EQUALITY** (I-7), two facts about the tracked Rust output `artifact`:
    * `whole`: the contract the Lean port prints from the render's OWN model - `partsOf`, with
      nothing sliced out of the artifact - IS the artifact, byte for byte;
    * `main` / `guard`: the two texts `CodegenAgrees` compares the AST with each occur in it
      exactly once, so the AST the semantics runs is tied to a region of the artifact itself. -/
structure ArtifactEq (m : Model) (artifact : String) : Prop where
  whole : renderHalo2Verifier (rootCtxOfVerifier m) (partsOf m) = artifact
  main : (artifact.splitOn (mainAssemblyText m)).length = 2
  guard : (artifact.splitOn (abiGuardText m)).length = 2

/-- **THE D-B5 ARTIFACT VARIANT.** The same three clauses as `ArtifactEq`, with the BUILD_ID
    INPUT SUPPLIED: every clause is read at the model whose `buildId` is the artifact's own
    `bytes32 public constant BUILD_ID = <value>` value. `buildId` is that value, not a free
    choice; the positive gates supply the literal the tracked artifact carries.

    Why this variant: the raw `ArtifactEq m artifact` is FALSE at the tracked verifier dump
    for both models whose render is otherwise the artifact - the sole differing line is the
    BUILD_ID line (`Instances/ArtifactB5Poseidon.lean:poseidon_diff_exact`,
    `ArtifactB5F1.lean:f1_diff_exact`, machine-checked). D-B5 pins the VK exactly and the
    verifier except that NAMED INPUT; this structure is that named-input gate, and it is
    NOT a weakening of `ArtifactEq` (which stays in the tree, with its refutation). -/
structure ArtifactEqV3 (m : Model) (artifact : String) (buildId : Word256) : Prop where
  whole : renderHalo2Verifier (rootCtxOfVerifier { m with buildId := buildId })
    (partsOf { m with buildId := buildId }) = artifact
  main : (artifact.splitOn (mainAssemblyText { m with buildId := buildId })).length = 2
  guard : (artifact.splitOn (abiGuardText { m with buildId := buildId })).length = 2

/-- The variant generalizes `ArtifactEq`: with the model's own `buildId` supplied, the
    record-update is the identity, so the three clauses are literally the raw ones. -/
theorem ArtifactEq.toArtifactEqV3 {m : Model} {artifact : String}
    (h : ArtifactEq m artifact) : ArtifactEqV3 m artifact m.buildId := by
  refine ⟨?_, ?_, ?_⟩
  · simpa using h.whole
  · simpa using h.main
  · simpa using h.guard

/-- And it is not weaker: when the supplied `buildId` IS the model's, a raw `ArtifactEq` follows. -/
theorem ArtifactEqV3.toArtifactEq {m : Model} {artifact : String} {buildId : Word256}
    (hm : m.buildId = buildId) (h : ArtifactEqV3 m artifact buildId) : ArtifactEq m artifact := by
  have hupd : ({ m with buildId := buildId } : Model) = m := by
    rw [← hm]
  refine ⟨?_, ?_, ?_⟩
  · simpa [hupd] using h.whole
  · simpa [hupd] using h.main
  · simpa [hupd] using h.guard

end Midfall.LoweringV2

