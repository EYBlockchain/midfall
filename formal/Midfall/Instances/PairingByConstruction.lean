-- |
-- Midfall.Instances.PairingByConstruction
--
-- REF.5 (card) / D-P62(a) (decision): THE DEPLOYMENT PAIRING, CONSTRUCTED - the five
-- D-P36a curve axioms are retired, not re-pinned.
--
-- `Assumptions/CurvePairing.lean` postulated `blsGT`, `blsGT_group`,
-- `blsGT_primeOrder`, `blsGT_module` and `bls12_381Pairing`: five axioms whose only
-- job was to give the verifier an `AdmissiblePairing` to be generic over. D-P62(a)
-- withdraws them, and this file supplies the instance by construction:
--
--   * the carrier is `G₁z` - the r-torsion subgroup generated by the published H1,
--     already built in `Instances/G1Agreement.lean` with its group, its
--     `PrimeOrderWith` and its `ZMod r` module;
--   * `G₂` is `G2fold`, the exponent model already used by the exhibit;
--   * `Gₜ` is `G₁z` again, and the pairing is `e(P, k) = k • P`. That is bilinear BY
--     TYPE (a linear map, curried), non-degenerate on the named generators, and it
--     needs no Miller loop, no `Fp12` and no real pairing.
--
-- WHAT THIS DOES AND DOES NOT CLAIM. It is an admissible pairing in the sense the
-- port's theorems need, not the BLS12-381 pairing. The claims the headline makes
-- through it are claims about the port's algebra, and the arithmetic facts about
-- real pairings that the deployment also relies on (bilinearity of the actual e, the
-- order of the actual groups) are carried by the curve library and by the fixture,
-- not by this instance. The gain is exact and checkable: the trusted base of
-- `holds_exhibited` drops from five named curve axioms to the standard three.
--
-- THE GENERATORS ARE NAMED: `g₁` is the published H1 as a carrier element
-- (`g1zGen`), `g₂` is exponent 1 (`g2foldExp 1`), whose `g2foldToEip` encoding is
-- the published H2.

import Midfall.Instances.G1Compressed
import Midfall.Instances.G1PointCount
import Midfall.Instances.HoldsStaging
import Midfall.Instances.G2Codec

set_option autoImplicit false

namespace Midfall.Instances
open Midfall Midfall.Yul Midfall.Assumptions Midfall.Halo2

/-- The published H1, as a carrier element, is not the identity. Decided by its
    coordinate pair, which `g1zPair` maps injectively. -/
theorem g1zGen_ne_one : g1zGen ≠ 1 := by
  intro h
  have := congrArg g1zPair h
  rw [g1zPair_gen, g1zPair_one] at this
  exact absurd this (by decide)

/-- `e(P, k) = k • P`, curried: `ZMod r`-bilinear because `Additive G₁z` is a
    `ZMod r`-module. Both linearity proofs are `add_smul` / `mul_smul` / `smul_comm`. -/
def eC : (Additive G₁z) →ₗ[ZMod blsR] (Additive G2fold) →ₗ[ZMod blsR] (Additive G₁z) where
  toFun P :=
    { toFun := fun k => (k.toMul.toAdd : ZMod blsR) • P
      map_add' := fun k l => add_smul (k.toMul.toAdd : ZMod blsR) (l.toMul.toAdd) P
      map_smul' := fun m k => mul_smul m (k.toMul.toAdd : ZMod blsR) P }
  map_add' := fun P Q => LinearMap.ext fun k => smul_add (k.toMul.toAdd : ZMod blsR) P Q
  map_smul' := fun m P => LinearMap.ext fun k => smul_comm (k.toMul.toAdd : ZMod blsR) m P

/-- **THE DEPLOYMENT PAIRING, CONSTRUCTED** (D-P62(a)). Replaces the five D-P36a
    axioms. No axiom is introduced here: the whole trusted base is the standard three. -/
instance pairingC : AdmissiblePairing G₁z G2fold G₁z where
  e := eC
  g₁ := g1zGen
  g₂ := g2foldExp 1
  hG₁ := g1zGen_ne_one
  hG₂ := g2foldExp_one_ne_one
  hNonDeg := by
    intro h
    have h1 : eC (Additive.ofMul g1zGen) (Additive.ofMul (g2foldExp 1)) =
        ((1 : ℕ) : ZMod blsR) • Additive.ofMul g1zGen := rfl
    rw [h1, Nat.cast_one, one_smul] at h
    exact g1zGen_ne_one (Additive.ofMul.injective h)
  decEqG₁ := inferInstance
  decEqGₜ := inferInstance

/-- The generators are NAMED, and by `rfl`: this is what the pin KATs read. -/
theorem pairingC_g1 : pairingC.g₁ = g1zGen := rfl
theorem pairingC_g2 : pairingC.g₂ = g2foldExp 1 := rfl

/-- `Eip2537.Holds` is exhibited with NO pairing axiom: `holds_staged` is generic in
    `Gₜ`, so instantiating it at `G₁z` is all that is needed. -/
theorem holds_exhibited_noAxiom :
    ∃ product : PairingProduct, Eip2537.Holds g1CodecZ g2CodecFold product :=
  holds_staged (Gₜ := G₁z)

/-- ... and at the COMPUTABLE codec, which is the one the deployment installs. -/
theorem holds_exhibited_C :
    ∃ product : PairingProduct, Eip2537.Holds g1CodecC g2CodecFold product := by
  obtain ⟨product, h⟩ := holds_exhibited_noAxiom
  exact ⟨product, holds_transfer g2CodecFold product h⟩

#print axioms pairingC
#print axioms holds_exhibited_noAxiom
#print axioms holds_exhibited_C

end Midfall.Instances
