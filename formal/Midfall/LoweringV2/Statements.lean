/-
  Midfall.LoweringV2.Statements

  THE V2 STATEMENT SURFACE for "the Lean verifier and the Solidity/Yul generated by the Lean port
  of the Rust codegen are equivalent".

  What changed from v1 (`Lowering/Obligations.lean`), and why each change is load-bearing:

  1. NO solc. There is no IR object, no `irCheck`, no `RunContractIR`, no `ir_refines`, no
     `ShellModel.wrap`. v1's `LoweringCorrect` was UNINHABITED for every Surface because
     `ir_refines` quantified over every object passing a check that accepts arbitrary programs
     (`Instances/LegacyVacuity.lean` proves it). The only Solidity semantics used is `EntryFrame`,
     a TRUSTED description of the state in which the body of `verifyProof` starts.

  2. NO FREE FIELDS. A `Render` carries the INPUTS of one render plus the generator outputs
     (plan, model) that `Render.Valid` checks against them. The program, the plan view, the
     constant table and the slices are functions (`Program.lean`). `Valid` ties the plan to the
     VERIFIER'S OWN verifying key (`circuitMeta`, `layout`), which v1 could not express (its fixture's plan
     and VK described different circuits with every pin green).

  3. NO OBLIGATION BUNDLE IN THE HEADLINE. `LoweringEquivalence R product` has hypotheses about the
     world, the hash, the calldata and the entry frame only. The per-block contracts are THEOREMS
     to prove (sorried here, registered in SORRY.md), and the composition is a theorem. At a
     deployment the headline is `lowering_equivalence_of_blocks` applied to proved block theorems
     and a proved `Valid`.

  4. CONTRACTS ARE ABOUT THE PROGRAM THAT RUNS. Blocks are slices of the CLOSED (inlined) program,
     run in the scope of the inlined helpers; v1's slices were un-inlined fragments whose helper
     calls are stuck, which made every forall-runs contract vacuous on the paths that matter.
     Completeness contracts are TOTAL (a run exists AND every run is good).

  First-headline scope (`SupportedV2`): no accumulator, embedded quotient VM, separate VK
  contract, production render. Each restriction is lifted by a named later package.

  SPLIT (Q0.3). §1-§5, §8 `HypothesesInhabited` and §9 `calldataOf` are the FROZEN statement
  surface: this file is hashed in `Midfall/LoweringV2/Frozen.sha256` and checked by
  `scripts/checks.sh`. §6 and §7 moved verbatim to `Blocks.lean`, which is REFINABLE, together
  with the two theorems `entryFrame_inhabited` and `end_to_end`; those two are now stated as the
  wrapper Props `EntryFrameInhabited` and `EndToEnd` defined below, which are the same
  propositions definitionally. Section numbers are kept as they were so PLAN-V2's references
  still resolve. No statement text was changed by the split. -/
import Midfall.LoweringV2.Program
import Midfall.LoweringV2.Shared
import Midfall.Lowering.Snapshot
import Midfall.Lowering.Calldata
import Midfall.Assumptions.Eip2537
import Midfall.Assumptions.Codec
import Midfall.Halo2.Exec.Native

namespace Midfall.LoweringV2

open Midfall Midfall.Halo2 Midfall.Generator Midfall.Lowering Midfall.Assumptions
open YulSemantics YulSemantics.EVM Midfall.Yul Midfall.Yul.Bridge

variable {p : ℕ} [Fact (Nat.Prime p)] {G₁ G₂ Gₜ : Type}
  [Group G₁] [Group G₂] [Group Gₜ]
  [PrimeOrderWith G₁ p] [PrimeOrderWith G₂ p] [PrimeOrderWith Gₜ p]
  [Module (ZMod p) (Additive G₁)] [Module (ZMod p) (Additive G₂)]
  [Module (ZMod p) (Additive Gₜ)] [AdmissiblePairing G₁ G₂ Gₜ]

/-! ## 1. One render -/

/-- One render: the verifier-side inputs (what the Lean verifier reads), the generator-side build
    inputs, and the generator OUTPUTS that `Valid` checks.

    `plan` is an output of `LoweringPlan::new` (P-11), which is not ported yet; until it is, `Valid`
    checks the plan against the VK instead (`circuitMeta`, `layout`, `invariants`) and WP-G4 turns those
    clauses into lemmas about the ported constructor. `qblocks` is the output of the unported
    QRS:2000 `compact_quotient_computation_blocks` (GAP G3); it is CHECKED, not trusted, because the
    quotient block contract must be proved about the code it produces. -/
structure Render (p : ℕ) [Fact (Nat.Prime p)] (G₁ G₂ Gₜ : Type)
    [Group G₁] [Group G₂] [Group Gₜ]
    [PrimeOrderWith G₁ p] [PrimeOrderWith G₂ p] [PrimeOrderWith Gₜ p]
    [Module (ZMod p) (Additive G₁)] [Module (ZMod p) (Additive G₂)]
    [Module (ZMod p) (Additive Gₜ)] [AdmissiblePairing G₁ G₂ Gₜ] where
  E : VerifierEnv p G₁ G₂ Gₜ
  params : ParamsVerifierKZG G₁ G₂
  vk : VerifyingKey (Fr p) G₁
  sG2gen : G₂
  encG2 : G₂ → Bytes
  cfg : GeneratorConfig
  inputs : ArtifactBuildInputs
  flags : RenderFlags
  plan : LoweringPlan Unit Unit
  qblocks : Midfall.Generator.QuotientFold.QuotientComputationBlocks
  model : Model

namespace Render

variable (R : Render p G₁ G₂ Gₜ)

/-- The plan view the emitter reads: derived. -/
def pv : PlanView := planViewOf R.plan R.model R.cfg.accumulator

/-- This render's contract constants: derived. -/
def consts : List (String × Nat) := constTableOf R.model

/-- THE PROGRAM, for the VK and evaluator addresses the deployment binds. -/
def prog (vkAddr qAddr : U256) : YulBlock := asmOf R.pv R.model vkAddr qAddr

/-- One block of the closed program. -/
def slice (q : Partial) : YulBlock := sliceOf R.pv R.model q

/-- The inlined helper definitions. -/
def helpers : YulBlock := helpersOf R.pv R.model

/-- The function scope every block runs in: the hoisted inlined helpers (the only `funDef`s of
    the program; `hoist_prog_eq_helpers` below is the obligation that says so). -/
def scope (c : ExternalCalls) (g : ExternalGas) : FunEnv (Bridge.Dialect c g) :=
  [hoist (Bridge.Dialect c g) R.helpers]

end Render

/-! ## 2. What makes a render THE generator's output for THIS verifying key -/

/-- The supported shape: `try_new`'s checks, what the proofs need, and the first-headline scope.
    Every clause is decidable or a computation on the render. -/
structure SupportedV2 (R : Render p G₁ G₂ Gₜ) : Prop where
  advice : R.vk.cs.numAdviceColumns ≠ 0
  instShape : R.vk.cs.numInstanceColumns = 2 ∧ R.cfg.numCommittedInstances = 1
  noRotInst : ∀ q ∈ R.vk.cs.instanceQueries.toList, q.2.int = 0
  singlePhase : R.vk.cs.numChallenges = 0
  hLimbs : R.vk.domain.getQuotientPolyDegree = R.vk.csDegree - 1
  vkPoints : ∀ C ∈ R.vk.fixedCommitments.toList ++ R.vk.permutation.commitments.toList,
    ptReadable (R.E.g1.toEip C)
  layout : R.plan.memory.map.WellFormed ∧ R.plan.memory.validate.isOk = true
  production : R.flags.trace = false ∧ R.flags.gasCheckpoints = false
  wf : R.vk.WellFormed Features.solidity
  /-- First-headline scope; lifted by WP-X1 (accumulator mode, compared to `ContractRef`). -/
  noAcc : R.cfg.accumulator = none
  /-- First-headline scope; lifted by WP-X2 (externalised evaluator). -/
  embeddedQuotient : R.flags.externalQuotient = false ∧ R.flags.expectedQuotient = none
  /-- The deployed profile; the embedded-VK render is WP-X3. -/
  separateVk : R.flags.separate = true

/-- VALIDITY: every clause is a fact about the render that is decided by computation at a
    deployment (by `decide`, `rfl` or, in `Instances/`, `native_decide`). None is a semantic
    obligation about the program. -/
structure Render.Valid (R : Render p G₁ G₂ Gₜ) : Prop where
  /-- The plan's circuit meta IS the ported meta of the verifier's own constraint system. This is
      the clause v1 could not state, and whose absence let `realSurface` pair a 72-slot plan with
      an 8-read VK. -/
  circuitMeta : ConstraintSystemMeta.new Features.solidity R.vk.cs R.cfg.numCommittedInstances =
    .ok R.plan.meta_
  /-- The calldata layout is the generator's own derivation from that meta (`plan.rs` `new`). -/
  layout : ProofCalldataLayout.fromProtocol R.plan.meta_.protocol abiVerifyProofProofCptr
      R.plan.meta_.numEvals R.plan.meta_.numPointSets = .ok R.plan.proofLayout
  /-- The plan passes the generator's own invariant validation (`plan.rs:427-437`). -/
  invariants : R.plan.validateGeneratorInvariants = .ok (.ok ())
  /-- The render model is the ported `artifacts.rs` output on this plan. -/
  model : generateVerifierFromPlan (fun _ _ => R.qblocks) R.inputs R.flags R.plan = .ok R.model
  /-- The build inputs are the configuration's and the VK's, not independent numbers. -/
  inputs : R.inputs.numInstances = R.cfg.numInstances ∧
    R.inputs.accEncoding = R.cfg.accumulator ∧ R.inputs.k = R.vk.domain.k ∧
    R.inputs.truncatedChallenges = Features.solidity.truncatedChallenges
  /-- The AST the semantics runs is the text the ported codegen prints (`Program.lean` §4). -/
  codegen : CodegenAgrees R.pv R.model
  /-- After inlining, the main block's only free names are the two wrapper locals. -/
  closed : mainClosed R.pv R.model = true
  /-- The payload words the contract loads (VK header, field constants, domain, G1/G2 bases)
      agree with the environment and VK the Lean verifier uses. -/
  slots : EnvAgrees R.E R.vk R.pv R.params R.sG2gen
  supported : SupportedV2 R
  /-- The generated program performs no world write (no `sstore`, `tstore`, `log*`, `create*`,
      value-bearing `call`), decided by the `Bridge.noWritersFuel` scan. -/
  noWriters : NoWriters (R.prog 0 0)
  /-- The generator's own `TRANSCRIPT_MPTR` lies above Solidity's reserved words, so an entry
      frame exists (`entryFrame_inhabited`). -/
  transcriptMptr : ∃ t, R.consts.lookup "TRANSCRIPT_MPTR" = some t ∧ 0x80 ≤ t

/-! ## 3. The world, the entry frame, the calls -/

/-- The deployment a render runs in: the VK contract holds the payload runtime the generator
    produced, the codehash constant agrees under the frame's hash, and the precompile addresses are
    free. Only `separateVk` renders are in scope (see `SupportedV2`). -/
structure DeploymentV2 (R : Render p G₁ G₂ Gₜ) (W : ExecEnv) (H : Hash) (vkAddr : U256) :
    Prop where
  keccak : W.keccakOf = hashOfBytes H
  wf : W.WF
  vkCode : W.extCodeOf vkAddr = R.plan.vk.runtimeBytes.data.toList
  vkHash : H R.plan.vk.runtimeBytes = keccak256 R.plan.vk.runtimeBytes
  vkNonEmpty : R.plan.vk.runtimeBytes.size ≠ 0
  disjoint : accountKey vkAddr ∉ ([0x0b, 0x0c, 0x0f, 0x05] : List Nat)

/-- **TRUSTED: the one place the Solidity language enters.** The state in which the generated body
    of `verifyProof` starts, for a call solc's dispatcher routed to it: the world and calldata of
    the call, a fresh frame (zero above `0x80`), a free-memory pointer below the generator's own
    `TRANSCRIPT_MPTR` (solc's prologue under the pinned compiler, MF-2), zero call value (the
    function is `view`), and the `verifyProof` selector. `activeWords` is left free because solc's
    prologue touches memory. Recorded in the trusted-base table (PLAN §1) as a replacement for the
    two solc rows; NOT validated against any compiler output inside Lean. -/
structure EntryFrame (R : Render p G₁ G₂ Gₜ) (W : ExecEnv) (Lyt : EVM.Layout) (H : Hash)
    (cd : Bytes) (st : EvmState) : Prop where
  shape : ∃ (mem₀ : Nat → UInt8) (aw : U256),
    st = { initState W Lyt H cd mem₀ with activeWords := aw }
  zeroAbove : ZeroAbove st.memory
  fmp : ∃ t, R.consts.lookup "TRANSCRIPT_MPTR" = some t ∧ (loadWord st.memory 0x40).toNat ≤ t
  callvalue : st.env.callvalue = 0
  selector : bytesTake cd 0 4 = some fnSigVerifyProof

/-- The honest precompiles (EIP-2537 G1ADD / G1MSM / PAIRING_CHECK, modexp). No evaluator slot:
    the first headline covers embedded-quotient renders only. -/
def callsOf (product : PairingProduct) : ExternalCalls :=
  honestCalls product 0 (fun _ _ _ => False)

/-- A committed run of the generated `verifyProof` body from an entry state. -/
def RunBody (R : Render p G₁ G₂ Gₜ) (vkAddr qAddr : U256) (c : ExternalCalls) (g : ExternalGas)
    (st₀ : EvmState) (obs : Obs) : Prop :=
  ∃ V', Bridge.RunCommitted c g (R.prog vkAddr qAddr) st₀ V' obs.state obs.outcome

/-! ## 4. The Lean side -/

/-- The Lean verifier accepts the calldata: it decodes at the render's own layout and the
    Rust-faithful message-level verifier accepts. No-accumulator form (`SupportedV2.noAcc`). -/
def LeanAccepts (R : Render p G₁ G₂ Gₜ) (H : Hash) (cd : Bytes) : Prop :=
  ∃ ms instW inst,
    decodeCalldata (p := p) R.plan.proofLayout R.cfg.numInstances R.E.g1 cd = some (ms, instW) ∧
    instOfWords? (p := p) instW = some inst ∧
    verifyMsgs (Gₜ := Gₜ) R.E H Features.solidity R.params R.vk inst ms = .ok ()

/-- Soundness side condition (v1 finding 5): Lean panics where `f_j(x) + β = 0`, the contract never
    inverts there. Excludes a negligible bad set; it MUST appear in the English headline. -/
def SoundSide (R : Render p G₁ G₂ Gₜ) (H : Hash) (cd : Bytes) : Prop :=
  ∀ ms instW inst,
    decodeCalldata (p := p) R.plan.proofLayout R.cfg.numInstances R.E.g1 cd = some (ms, instW) →
    instOfWords? (p := p) instW = some inst →
    prepareMsgs (Gₜ := Gₜ) R.E H Features.solidity R.vk inst ms ≠
      .error (Fault.panic "proofs/src/plonk/logup.rs:460")

/-- Completeness side condition (v1 finding 4): the contract rejects `xⁿ = 1` and `x = ωⁱ` in the
    rotation window, Lean does not. Excludes a negligible bad set; it MUST appear in the headline. -/
def CompleteSide (R : Render p G₁ G₂ Gₜ) (H : Hash) (cd : Bytes) : Prop :=
  ∀ ms instW inst (Snap : Snapshot p G₁ G₂ Gₜ),
    decodeCalldata (p := p) R.plan.proofLayout R.cfg.numInstances R.E.g1 cd = some (ms, instW) →
    instOfWords? (p := p) instW = some inst →
    snapshotOf R.E H R.vk inst ms none = .ok Snap → ChallengesGood R.vk Snap

/-! ## 5. THE HEADLINE -/

/-- **Lowering equivalence for one render.** For every world the render is deployed into, every
    hash, every calldata and every entry frame:

    1. soundness - under precompiles that may fail but never lie, and ANY gas oracle, a run that
       returns returns ABI `true`, and the Lean verifier accepts;
    2. completeness - if the Lean verifier accepts, an honest run exists and every honest run
       returns ABI `true` with the world unchanged;
    3. two outcomes - every run returns ABI `true` or reverts/halts with the world unchanged.

    No hypothesis mentions the program. -/
def LoweringEquivalence (R : Render p G₁ G₂ Gₜ) (product : PairingProduct) : Prop :=
  ∀ (W : ExecEnv) (Lyt : EVM.Layout) (H : Hash) (vkAddr : U256) (cd : Bytes) (st₀ : EvmState),
    DeploymentV2 R W H vkAddr → EntryFrame R W Lyt H cd st₀ →
    Eip2537.Holds R.E.g1 ⟨R.encG2⟩ product →
    (∀ (g : ExternalGas) (obs : Obs),
        RunBody R vkAddr 0 (permissive (callsOf product)) g st₀ obs → obs.isReturn →
        SoundSide R H cd → obs.returnData = abiTrue ∧ LeanAccepts R H cd) ∧
    (LeanAccepts R H cd → CompleteSide R H cd → G1CodecLaws R.E.g1 →
        (∃ obs, RunBody R vkAddr 0 (callsOf product) (ExternalGas.ofFun fun _ => 0) st₀ obs) ∧
        ∀ obs, RunBody R vkAddr 0 (callsOf product) (ExternalGas.ofFun fun _ => 0) st₀ obs →
          obs.view = returnView st₀) ∧
    (∀ (g : ExternalGas) (obs : Obs),
        RunBody R vkAddr 0 (permissive (callsOf product)) g st₀ obs →
        obs.view = returnView st₀ ∨ (obs.isRevertOrHalt ∧ obs.worldUnchanged st₀))

/-! ## 8. Non-vacuity (D-P23, applied to the WHOLE hypothesis set this time) -/

/-- Every hypothesis of `LoweringEquivalence` holds at once at this render, with a calldata the side
    conditions admit. Must be PROVED at each deployment the headline is claimed for. -/
def HypothesesInhabited (R : Render p G₁ G₂ Gₜ) (product : PairingProduct) : Prop :=
  ∃ (W : ExecEnv) (Lyt : EVM.Layout) (H : Hash) (vkAddr : U256) (cd : Bytes) (st₀ : EvmState),
    DeploymentV2 R W H vkAddr ∧ EntryFrame R W Lyt H cd st₀ ∧
      Eip2537.Holds R.E.g1 ⟨R.encG2⟩ product ∧ SoundSide R H cd ∧ CompleteSide R H cd

/-- THE STATEMENT OF `entryFrame_inhabited` AS A PROP (Q0.3 wrapper). The binder telescope is
    `entryFrame_inhabited`'s, verbatim, and the body is its conclusion, verbatim: the wrapper is
    a DEFINITIONAL one (`EntryFrameInhabited R W Lyt H cd hsel hcv ht = ∃ st₀, EntryFrame R W Lyt
    H cd st₀` holds by `rfl`), so wrapping changes no proposition. The theorem itself is stated as
    `EntryFrameInhabited ...` in `Blocks.lean` (REFINABLE). -/
def EntryFrameInhabited (R : Render p G₁ G₂ Gₜ) (W : ExecEnv) (Lyt : EVM.Layout) (H : Hash)
    (cd : Bytes) (hsel : bytesTake cd 0 4 = some fnSigVerifyProof) (hcv : W.callvalue = 0)
    (ht : ∃ t, R.consts.lookup "TRANSCRIPT_MPTR" = some t ∧ 0x80 ≤ t) : Prop :=
  ∃ st₀, EntryFrame R W Lyt H cd st₀

/-! ## 9. End to end, from the compressed Rust proof -/

/-- The calldata the ported repacker and encoder produce for a compressed proof. -/
def calldataOf (R : Render p G₁ G₂ Gₜ) (π : Bytes) (inst : Array (Fr p)) :
    Except Midfall.Generator.GeneratorError Bytes :=
  (repackProof (p := p) (RepackedProofLayoutPlan.fromProofLayout R.plan.proofLayout) R.E.g1 π).mapError
      Midfall.Generator.GeneratorError.fromRepackError >>= fun π' =>
    encodeCalldata (p := p) R.cfg.numInstances
      (RepackedProofLayoutPlan.fromProofLayout R.plan.proofLayout) R.E.g1 π' inst

/-- THE STATEMENT OF `end_to_end` AS A PROP (Q0.3 wrapper). The binder telescope is `end_to_end`'s
    verbatim and the body is its conclusion verbatim, so the two forms are equal by `rfl`: the
    wrapper adds no hypothesis, drops none, and reorders none. The theorem is stated as
    `EndToEnd R product hR hEq W Lyt vkAddr hdep hcv hpc hcodec hcomp inst π hn hside` in
    `Blocks.lean` (REFINABLE). -/
def EndToEnd (R : Render p G₁ G₂ Gₜ) (product : PairingProduct) (hR : R.Valid)
    (hEq : LoweringEquivalence R product)
    (W : ExecEnv) (Lyt : EVM.Layout) (vkAddr : U256)
    (hdep : DeploymentV2 R W keccak256 vkAddr) (hcv : W.callvalue = 0)
    (hpc : Eip2537.Holds R.E.g1 ⟨R.encG2⟩ product) (hcodec : G1CodecLaws R.E.g1)
    (hcomp : R.E.g1.compressedRoundtrip)
    (inst : Array (Fr p)) (π : Bytes) (hn : inst.size = R.cfg.numInstances)
    (hside : ∀ cd, calldataOf R π inst = .ok cd →
      SoundSide R keccak256 cd ∧ CompleteSide R keccak256 cd) : Prop :=
  verifyNative (Gₜ := Gₜ) R.E Features.solidity R.params R.vk inst π = .ok () ↔
    ∃ cd, calldataOf R π inst = .ok cd ∧
      ∀ st₀, EntryFrame R W Lyt keccak256 cd st₀ →
        (∃ obs, RunBody R vkAddr 0 (callsOf product) (ExternalGas.ofFun fun _ => 0) st₀ obs) ∧
        ∀ obs, RunBody R vkAddr 0 (callsOf product) (ExternalGas.ofFun fun _ => 0) st₀ obs →
          obs.view = returnView st₀

end Midfall.LoweringV2