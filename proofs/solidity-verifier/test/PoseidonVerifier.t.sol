        uint256 off = 0;
        uint256 x = _readUint(f, off); off += 32;
        uint256 xn = _readUint(f, off); off += 32;
        uint256 n = _readUint(f, off); off += 32;
        uint256 omega = _readUint(f, off); off += 32;
        uint256 bf = _readUint(f, off); off += 32;
